# Copy this file to .env for local Docker development.
POSTGRES_DB=careconnect
POSTGRES_USER=careconnect
POSTGRES_PASSWORD=careconnect-local-change-me
SECRET_KEY=development-only-change-this-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENVIRONMENT=development
VOICE_WEBHOOK_SECRET=
